<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-test for Shields Up's AI-access surface: wires the shared
       AutoCommand III bridge engine under THIS app's identity (real one -
       port base 47861, %LOCALAPPDATA%\ShieldsUp\agent) and drives it over
       the wire exactly the way an MCP client would. Read-only checks; the
       session is stopped and its file removed at the end. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShieldsUpSelfTest</AssemblyName>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShieldsUp.Core\ShieldsUp.Core.csproj" />
  </ItemGroup>
</Project>
