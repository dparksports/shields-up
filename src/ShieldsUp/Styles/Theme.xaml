<?xml version="1.0" encoding="utf-8"?>
<!-- ShieldsUp design system — dark only. The app forces RequestedTheme="Dark" on
     its root, and every value here is picked for ≥4.5:1 contrast on its surface.
     Palette ported from AutoCommand's dark theme. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="CardBackgroundColor">#1E1E1E</Color>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="RowAlternateBrush" Color="#272727" />

    <!-- Text: bright enough for 12px body text on #1E1E1E (≈9:1) -->
    <SolidColorBrush x:Key="PageHeaderTextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#C9C9C9" />
    <SolidColorBrush x:Key="GridTextBrush" Color="#F2F2F2" />

    <!-- Accents: bright variants for status text; deep variants for button fills
         so white labels keep ≥4.5:1 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3FDD87" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7FE8AE" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#1F8B4C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8177" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF9C90" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="#C42B1F" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E7B10A" />
    <SolidColorBrush x:Key="OkBrush" Color="#3FDD87" />

    <!-- Text -->
    <x:Double x:Key="PageHeaderSize">26</x:Double>

    <Style x:Key="PageHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PageHeaderSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{StaticResource PageHeaderTextBrush}" />
    </Style>

    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="Foreground" Value="{StaticResource PageHeaderTextBrush}" />
    </Style>

    <!-- Cards: the port of AutoCommand's CardPanel + GroupBox look -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,4,0,12" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas,Cascadia Mono" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource GridTextBrush}" />
    </Style>

    <!-- CommunityToolkit DataGrid: pin readable foregrounds regardless of the
         control's internal theme-resource resolution -->
    <SolidColorBrush x:Key="DataGridForeground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="DataGridCellForeground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="DataGridRowForeground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="DataGridColumnHeaderForeground" Color="#F2F2F2" />

</ResourceDictionary>
