<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:ShieldsUp.Converters"
    Loaded="Page_Loaded">
    <Page.Resources>
        <converters:TaskStateToColorConverter x:Key="StateColor" />
    </Page.Resources>

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Scheduled Tasks" Style="{StaticResource PageHeaderText}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <RadioButton x:Name="AllRadio" Content="All" Checked="FilterChanged" />
            <RadioButton x:Name="RunningRadio" Content="Running" IsChecked="True" Checked="FilterChanged" />
            <RadioButton x:Name="ReadyRadio" Content="Ready" Checked="FilterChanged" />
            <RadioButton x:Name="DisabledRadio" Content="Disabled" Checked="FilterChanged" />
            <TextBlock x:Name="TaskCountText" Text="" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Tasks Grid -->
        <controls:DataGrid Grid.Row="2" x:Name="TasksGrid" AutoGenerateColumns="False"
                           IsReadOnly="True" SelectionMode="Single" Foreground="#F2F2F2">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Name" Binding="{Binding TaskName}" Width="*" />
                <controls:DataGridTextColumn Header="Path" Binding="{Binding TaskPath}" Width="200" />
                <controls:DataGridTemplateColumn Header="State" Width="90">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding State}" FontWeight="SemiBold"
                                       Foreground="{Binding State, Converter={StaticResource StateColor}}"
                                       VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200" />
                <controls:DataGridTextColumn Header="User" Binding="{Binding User}" Width="120" />
            </controls:DataGrid.Columns>
            <controls:DataGrid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Disable Task" Click="DisableTask_Click" />
                    <MenuFlyoutItem Text="Enable Task" Click="EnableTask_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Run Task" Click="RunTask_Click" />
                    <MenuFlyoutItem Text="Stop Task" Click="StopTask_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Delete Task" Click="DeleteTask_Click" />
                </MenuFlyout>
            </controls:DataGrid.ContextFlyout>
        </controls:DataGrid>
    </Grid>
</Page>
