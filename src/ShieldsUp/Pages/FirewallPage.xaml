<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.FirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:ShieldsUp.Converters"
    Loaded="Page_Loaded">
    <Page.Resources>
        <converters:EnabledToColorConverter x:Key="EnabledToColor" />
        <converters:ActionToColorConverter x:Key="ActionToColor" />
    </Page.Resources>

    <Grid Padding="24,16,24,24" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Advanced Firewall Settings" Style="{StaticResource PageHeaderText}" />
                <TextBlock Text="Manage Windows Defender Firewall profiles and port rules via native COM APIs."
                           Style="{StaticResource SubtleText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Quick Profile:" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox x:Name="ProfileCombo" Width="150" SelectionChanged="ProfileCombo_SelectionChanged">
                    <ComboBoxItem Content="Custom (Current)" IsSelected="True" />
                    <ComboBoxItem Content="Shield Up" />
                    <ComboBoxItem Content="Gaming" />
                    <ComboBoxItem Content="Office" />
                    <ComboBoxItem Content="Home" />
                    <ComboBoxItem Content="Public Strict" />
                </ComboBox>
                <Button x:Name="RefreshBtn" Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" />
                <Button x:Name="RestoreInternetBtn" Content="🌐 Restore Internet"
                        Style="{StaticResource DangerButton}" Click="RestoreInternetBtn_Click"
                        ToolTipService.ToolTip="Panic button: disables every Shields Up / AutoCommand block rule (AC-BLOCK fleet) at once." />
            </StackPanel>
        </Grid>

        <!-- View Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <RadioButton x:Name="InboundRadio" Content="Inbound Rules" IsChecked="True" Checked="FilterChanged" />
            <RadioButton x:Name="OutboundRadio" Content="Outbound Rules" Checked="FilterChanged" />
            <TextBlock x:Name="RuleCountText" Text="" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
            <Button x:Name="RenameLegacyBtn" Content="✏️ Rename legacy blocks" Click="RenameLegacyBtn_Click" IsEnabled="False"
                    ToolTipService.ToolTip="Recreate AutoCommand block rules still using the legacy 'AutoCommand IP Block / Process Block' names under the current AC-BLOCK naming. Lossless: descriptions carry over, redundant inbound duplicates are removed, protection unchanged." />
            <ProgressBar x:Name="ProfileProgress" Width="120" Height="14" IsIndeterminate="True"
                         Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="ProfileStatusText" Text="" Style="{StaticResource SubtleText}" FontStyle="Italic"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
        </StackPanel>

        <!-- Rules Grid -->
        <controls:DataGrid Grid.Row="2" x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                           SelectionMode="Single" Foreground="#1D1D1F">
            <controls:DataGrid.Columns>
                <controls:DataGridTemplateColumn Header="Enabled" Width="80">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EnabledDisplay}" FontWeight="SemiBold"
                                       Foreground="{Binding Enabled, Converter={StaticResource EnabledToColor}}"
                                       VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Action" Width="70">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Action}"
                                       Foreground="{Binding Action, Converter={StaticResource ActionToColor}}"
                                       VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                <controls:DataGridTextColumn Header="Group" Binding="{Binding DisplayGroup}" Width="170" />
                <controls:DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                <controls:DataGridTextColumn Header="Local Port" Binding="{Binding LocalPort}" Width="80" />
                <controls:DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteAddress}" Width="130" />
                <controls:DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="110" />
            </controls:DataGrid.Columns>
            <controls:DataGrid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Toggle Rule" Click="ToggleRule_Click" />
                    <MenuFlyoutItem Text="Enable Entire Group" Click="EnableGroup_Click" />
                    <MenuFlyoutItem Text="Disable Entire Group" Click="DisableGroup_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Save to Config" Click="SaveToConfig_Click" />
                </MenuFlyout>
            </controls:DataGrid.ContextFlyout>
        </controls:DataGrid>
    </Grid>
</Page>
