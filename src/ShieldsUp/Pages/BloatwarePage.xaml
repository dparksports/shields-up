<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.BloatwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:conv="using:ShieldsUp.Converters"
    Loaded="Page_Loaded">

    <Page.Resources>
        <conv:BloatwareStateConverter x:Key="BloatwareStateConverter" />
        <conv:SignatureStatusConverter x:Key="SignatureStatusConverter" />
        <conv:TrueToVisibleConverter x:Key="TrueToVisible" />
    </Page.Resources>

    <Grid Padding="24,16,24,24" Background="{StaticResource PageBackgroundBrush}"
          SizeChanged="Page_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the three actions drop under the title when the window is
             narrow (at 800x600 the content area is ~704 DIPs and the inline
             title + buttons need ~730). -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Wide/narrow header switching is driven from code-behind
                 (ApplyResponsiveHeader); see FirewallPage for the rationale. -->

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bloatware" Style="{StaticResource PageHeaderText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />

            <StackPanel x:Name="HeaderActions" Grid.Row="0" Grid.Column="1"
                        Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="↻ Refresh List" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" />
                <Button x:Name="RemoveBloatwareBtn" Content="🧹 Remove Bloatware"
                        Style="{StaticResource DangerButton}" Click="RemoveBloatwareBtn_Click"
                        ToolTipService.ToolTip="Uninstall Outlook, Xbox, Phone Link, Teams, Copilot, OneDrive and other preinstalled apps after confirmation." />
                <Button x:Name="ManageBloatwareBtn" Content="⚙ Manage List"
                        Style="{StaticResource PrimaryButton}" Click="ManageBloatwareBtn_Click"
                        ToolTipService.ToolTip="Customize which apps count as bloatware: enable/disable defaults, add your own." />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="The Store-packaged apps Windows Settings shows under Apps → Installed apps — apps you can uninstall (Outlook, Teams, Copilot, …). Win32 desktop apps such as OneDrive are only targeted by Remove Bloatware."
                       Style="{StaticResource SubtleText}" />
        </Grid>

        <!-- View Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
            <CheckBox x:Name="SystemComponentsCheck" Content="Include system components (OS-signed)"
                      VerticalAlignment="Center"
                      Checked="FilterChanged" Unchecked="FilterChanged" />
            <TextBlock x:Name="AppCountText" Text="" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Optional Microsoft apps: shipped with Windows, deliberately kept out
             of Remove Bloatware, removable one at a time on request. Collapsed
             by default so the grid keeps its height on a 800x600 desktop. -->
        <Expander x:Name="OptionalAppsExpander" Grid.Row="2" Margin="0,0,0,12"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Header="Remove individual Microsoft apps">
            <StackPanel>
                <TextBlock Text="Bing, Clock, Camera, Paint, Weather, Clipchamp, Snipping Tool and more ship with Windows, so Remove Bloatware leaves them alone. Take out only what you don't use — each one comes back from the Microsoft Store if you change your mind."
                           Style="{StaticResource SubtleText}" Margin="0,0,0,6" />
                <ScrollViewer x:Name="OptionalListScroller" MaxHeight="240"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="OptionalAppsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource SubtleText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource SubtleText}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Remove" Click="RemoveOptionalApp_Click"
                                            Visibility="{Binding CanRemove, Converter={StaticResource TrueToVisible}}"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Expander>

        <!-- Apps List -->
<Border Style="{StaticResource ContentPanel}" Grid.Row="3">
        <controls:DataGrid x:Name="AppsDataGrid" Grid.Row="2" AutoGenerateColumns="False"
                           IsReadOnly="True" SelectionMode="Single" Foreground="#1D1D1F">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="App Name" Binding="{Binding Name}" Width="2*" />
                <controls:DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                <controls:DataGridTemplateColumn Header="Signature Status" Width="*">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SignatureStatus}"
                                       Foreground="{Binding SignatureStatus, Converter={StaticResource SignatureStatusConverter}}"
                                       VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn Header="Signer / Publisher" Binding="{Binding SignerCertificate}" Width="2*" />
                <!-- One-click list membership: add exact package / disable the
                     matching default pattern. Collapses on non-toggleable rows. -->
                <controls:DataGridTemplateColumn Header="Bloatware" Width="115">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Converter={StaticResource BloatwareStateConverter}}"
                                    Visibility="{Binding Converter={StaticResource BloatwareStateConverter}, ConverterParameter=visibility}"
                                    ToolTipService.ToolTip="{Binding Converter={StaticResource BloatwareStateConverter}, ConverterParameter=tooltip}"
                                    Click="BloatwareToggle_Click" Padding="8,2" FontSize="10" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Action" Width="100">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Uninstall" Style="{StaticResource DangerButton}"
                                    Padding="8,2" FontSize="10" Click="UninstallBtn_Click" />
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
        </Border>

        <!-- Footer Info -->
        <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource CardPanel}" Padding="12">
            <TextBlock Text="Note: Removing system-critical apps may cause instability. Use with caution. Signature status reflects the package's deployment-validated signature kind (Store / Enterprise signatures are valid); the signer is taken from the package publisher."
                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
