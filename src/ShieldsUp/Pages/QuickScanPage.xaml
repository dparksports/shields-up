<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.QuickScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Quick Scan" Style="{StaticResource PageHeaderText}" />
            <TextBlock Text="Everything a fresh Windows 11 install needs, in one pass. Each step reuses the exact actions behind its dedicated page — the checklist doubles as a live status dashboard."
                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Action Row -->
        <Grid Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ApplyAllBtn" Grid.Column="0" Content="▶  Apply All Steps"
                    Style="{StaticResource PrimaryButton}" FontWeight="SemiBold"
                    Click="ApplyAllBtn_Click"
                    ToolTipService.ToolTip="Runs every step below in order, with progress tracking and a final verification pass." />
            <ProgressBar x:Name="OverallProgress" Grid.Column="1" Width="260" Height="16"
                         Minimum="0" Maximum="7" Value="0" VerticalAlignment="Center" />
            <TextBlock x:Name="SetupStatusText" Grid.Column="2" Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Ready. Press Apply to harden this machine in one pass." />
        </Grid>

        <!-- Checklist (bird's-eye view) -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="StepsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardPanel}" Padding="14,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18"
                                           Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                           Width="24" TextAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                           Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                           MaxWidth="380" TextWrapping="Wrap" TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CardPanel}" Padding="12">
            <TextBlock Text="Note: device removals, firewall rules, IPv6 and UAC changes fully take effect after a reboot."
                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
