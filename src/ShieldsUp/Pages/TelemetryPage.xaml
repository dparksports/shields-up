<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.TelemetryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Loaded="Page_Loaded">

    <ScrollViewer Background="{StaticResource PageBackgroundBrush}">
        <StackPanel Padding="24,16,24,24" MaxWidth="980" HorizontalAlignment="Left" Spacing="16">

            <StackPanel>
                <TextBlock Text="Telemetry Opt-Out" Style="{StaticResource PageHeaderText}" />
                <TextBlock Text="Many installed apps and libraries phone home usage statistics by default. This tab knows the official opt-out switch for each one, shows whether it is currently on, and applies or reverts the setting with the previous value snapshotted — nothing here is a one-way door. For software that ignores its own switch, rules can also block the telemetry domain at the network level."
                           Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource ContentPanel}">
                <StackPanel Spacing="12">

                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Detected software" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                                <Button x:Name="ScanBtn" Grid.Column="1" Content="Rescan" Style="{StaticResource PrimaryButton}"
                                        Click="ScanBtn_Click" />
                            </Grid>
                            <TextBlock x:Name="StatusText" Text="Scanning…" Style="{StaticResource SubtleText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <controls:DataGrid x:Name="RulesGrid" MinHeight="160" MaxHeight="400"
                                               AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Foreground="#1D1D1F">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="170" />
                                    <controls:DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" />
                                    <controls:DataGridTemplateColumn Header="Status" Width="140">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                           VerticalAlignment="Center" Margin="8,0"
                                                           ToolTipService.ToolTip="{Binding Evidence}" />
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                    <controls:DataGridTemplateColumn Header="Evidence" Width="*">
                                        <controls:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Evidence}" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding Evidence}"
                                                           VerticalAlignment="Center" Margin="8,0" />
                                            </DataTemplate>
                                        </controls:DataGridTemplateColumn.CellTemplate>
                                    </controls:DataGridTemplateColumn>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button x:Name="OptOutBtn" Content="Opt out selected" Style="{StaticResource PrimaryButton}"
                                        Click="OptOutBtn_Click" />
                                <Button x:Name="RevertBtn" Content="Revert selected" Click="RevertBtn_Click"
                                        ToolTipService.ToolTip="Restores the setting that was in place before the opt-out." />
                                <Button x:Name="BlockBtn" Content="Block network instead" Click="BlockBtn_Click" Visibility="Collapsed"
                                        ToolTipService.ToolTip="Pins the telemetry domain to 0.0.0.0 in the hosts file — enforcement that works even when the app ignores its own switch." />
                                <Button x:Name="UnblockBtn" Content="Remove network block" Click="UnblockBtn_Click" Visibility="Collapsed" />
                                <Button x:Name="VerifyBtn" Content="Verify: still beaconing?" Click="VerifyBtn_Click"
                                        ToolTipService.ToolTip="Checks the DNS resolver cache for the telemetry domains this app is known to contact." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="How this works" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SubtleText}"
                                       Text="Each entry applies the vendor's own documented opt-out (a settings key, environment variable or policy), written in exactly the token type the target reads, verified by re-reading the file, and snapshotted to telemetry_state.json so Revert puts back exactly what was there. Opt-outs only affect processes started after the change. When a rule offers 'Block network instead', it pins the telemetry domain to 0.0.0.0 in the hosts file — system-wide for that domain (browsers' requests to it fail too), reversible here, and it never depends on the target honoring anything." />
                            <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource SubtleText}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
