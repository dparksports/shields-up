<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.AttackSurfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Attack Surface" Style="{StaticResource PageHeaderText}" VerticalAlignment="Center" />
                <Button x:Name="RefreshBtn" Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- At-a-glance counts: 2x3 equal cells so nothing clips at 800px width -->
        <Border Grid.Row="1" Margin="0,0,0,12" Background="#F2F5FA" BorderBrush="#E1E7F0"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid RowSpacing="6" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="WAN Miniports" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="MiniportCountText" Text="…" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="WiFi Direct" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="WifiDirectCountText" Text="…" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="KDNET" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="KdnetCountText" Text="…" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="SSTP Service" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SstpCountText" Text="…" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Name-Res Doors" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="NameResCountText" Text="…" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Hotpatch Task" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HotpatchCountText" Text="…" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Four full-width lists -->
<Border Style="{StaticResource ContentPanel}" Grid.Row="2">
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left" Spacing="12">

                <!-- List 1: WAN Miniport Removal -->
                <StackPanel ToolTipService.ToolTip="Remove all WAN Miniport phantom devices">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="WAN Miniport Cleanup" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="MiniportSectionCount" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </StackPanel>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                            <TextBlock Text="Remove all WAN Miniports."
                                       Style="{StaticResource SubtleText}" TextAlignment="Center" />
                            <Button x:Name="RemoveAllMiniportsBtn" Content="Remove All Miniports"
                                    Style="{StaticResource DangerButton}" Click="RemoveAllMiniportsBtn_Click"
                                    HorizontalAlignment="Center" />
                            <TextBlock x:Name="RemovalResultText" Text="" Style="{StaticResource SubtleText}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- List 2: SSTP / WAN Miniports -->
                <StackPanel ToolTipService.ToolTip="WAN Miniport SSTP — remote access attack surface">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="System VPN Backdoors" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="SstpSectionCount" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </StackPanel>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SSTP Service (sstpsvc)" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SstpStatusText" Text="Loading..." Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <Button x:Name="SstpToggleBtn" Grid.Column="1" Content="Disable + Neuter"
                                        Style="{StaticResource PrimaryButton}" Click="SstpToggleBtn_Click" />
                            </Grid>

                            <TextBlock Text="WAN MINIPORTS" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,0" />
                            <controls:DataGrid x:Name="WanMiniportGrid" MinHeight="110" MaxHeight="240"
                                               AutoGenerateColumns="False" IsReadOnly="True" Foreground="#1D1D1F">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- List 3: WiFi Direct -->
                <StackPanel ToolTipService.ToolTip="WiFi Direct Hosted Network — hidden hotspot attack surface">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Ghost Hotspots" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="WifiDirectSectionCount" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </StackPanel>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hosted Network (WiFi)" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WifiDirectStatusText" Text="Loading..." Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <Button x:Name="WifiDirectToggleBtn" Grid.Column="1" Content="Toggle"
                                        Style="{StaticResource PrimaryButton}" Click="WifiDirectToggleBtn_Click" />
                            </Grid>

                            <Button x:Name="UninstallWifiBtn" Content="Uninstall Adapter" HorizontalAlignment="Left"
                                    Style="{StaticResource DangerButton}" Click="UninstallWifiBtn_Click" />

                            <TextBlock Text="WIFI DIRECT ADAPTERS" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,0" />
                            <controls:DataGrid x:Name="WifiDirectGrid" MinHeight="110" MaxHeight="240"
                                               AutoGenerateColumns="False" IsReadOnly="True" Foreground="#1D1D1F">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- List 4: KDNET -->
                <StackPanel ToolTipService.ToolTip="Kernel Debug Network Adapter (KDNET) — kernel-level access">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Hacker Access Mode" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="KdnetSectionCount" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </StackPanel>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="KDNET Adapter" FontWeight="SemiBold" />
                                    <TextBlock x:Name="KdnetStatusText" Text="Loading..." Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <Button x:Name="KdnetToggleBtn" Grid.Column="1" Content="Toggle"
                                        Style="{StaticResource PrimaryButton}" Click="KdnetToggleBtn_Click" />
                            </Grid>

                            <TextBlock Text="DEBUG ADAPTERS" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,0" />
                            <controls:DataGrid x:Name="KdnetGrid" MinHeight="110" MaxHeight="240"
                                               AutoGenerateColumns="False" IsReadOnly="True" Foreground="#1D1D1F">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- List 5: Legacy Name-Resolution Doors -->
                <StackPanel ToolTipService.ToolTip="Broadcast/multicast name-resolution protocols (LLMNR, NetBIOS over TCP/IP, mDNS) — credential-poisoning &amp; LAN discovery surface">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Legacy Name-Resolution Doors" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="NameResSectionCount" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </StackPanel>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LLMNR (UDP 5355 multicast)" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LlmnrStatusText" Text="Loading..." Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="LlmnrToggleBtn" Grid.Column="1" Content="Disable LLMNR"
                                        Style="{StaticResource PrimaryButton}" Click="LlmnrToggleBtn_Click" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NetBIOS over TCP/IP (UDP 137–139)" FontWeight="SemiBold" />
                                    <TextBlock x:Name="NetbiosStatusText" Text="Loading..." Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="NetbiosToggleBtn" Grid.Column="1" Content="Disable NetBIOS"
                                        Style="{StaticResource PrimaryButton}" Click="NetbiosToggleBtn_Click" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="mDNS Multicast (UDP 5353 — firewall-scoped)" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MdnsStatusText" Text="Loading..." Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="MdnsToggleBtn" Grid.Column="1" Content="Block Outbound mDNS"
                                        Style="{StaticResource PrimaryButton}" Click="MdnsToggleBtn_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- List 6: Windows Hotpatch Monitoring Task -->
                <StackPanel ToolTipService.ToolTip="\Microsoft\Windows\Hotpatch\Monitoring — boot-time SYSTEM servicing readiness task (Windows 11 24H2+)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Windows Hotpatch Monitoring" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="HotpatchSectionCount" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </StackPanel>
                    <Border Style="{StaticResource CardPanel}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="\Microsoft\Windows\Hotpatch\Monitoring" FontWeight="SemiBold" />
                                <TextBlock x:Name="HotpatchStatusText" Text="Loading..." Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="HotpatchToggleBtn" Grid.Column="1" Content="Disable Task"
                                    Style="{StaticResource PrimaryButton}" Click="HotpatchToggleBtn_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</Page>
