<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.UnblockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,24" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Unblock" Style="{StaticResource PageHeaderText}" Grid.Row="0" />

<Border Style="{StaticResource ContentPanel}" Grid.Row="1">
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">

                <!-- Mark-of-the-Web removal -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Mark-of-the-Web removal" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="Windows marks downloaded files with a Zone.Identifier stream — SmartScreen then warns on every launch. Removing the mark from an extracted zip restores normal behaviour."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UnblockAppBtn" Content="Unblock this app's folder"
                                    Style="{StaticResource PrimaryButton}" Click="UnblockAppBtn_Click" />
                            <Button x:Name="UnblockFolderBtn" Content="Unblock another folder…"
                                    Click="UnblockFolderBtn_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UnblockStatusText" Text="" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- How this works -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="How this works" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="The Zone.Identifier alternate data stream is deleted from every file under the chosen folder (the equivalent of Unblock-File). File contents are untouched — only the download mark is removed, so SmartScreen / Smart App Control stop treating the files as coming from the internet."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</Page>
