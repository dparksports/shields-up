<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.UpdateControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Loaded="Page_Loaded">

    <ScrollViewer Background="{StaticResource PageBackgroundBrush}">
        <StackPanel Padding="24,16,24,24" MaxWidth="980" HorizontalAlignment="Left" Spacing="16">

            <StackPanel>
                <TextBlock Text="Update Control" Style="{StaticResource PageHeaderText}" />
                <TextBlock Text="Some apps silently replace themselves in place (rename the old exe to .old, write a new one). Freezing an app adds an NTFS deny rule for delete/write on its exe: the app keeps running normally, but its updater fails until you unfreeze it. The original permissions are snapshotted first, so unfreezing restores exactly what was there."
                           Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Self-updating apps" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                        <Button x:Name="DiscoverBtn" Grid.Column="1" Content="Discover" Style="{StaticResource PrimaryButton}"
                                Click="DiscoverBtn_Click" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="Press Discover to scan for self-updating apps (self-update .old leftovers, updater folders, autostart updaters)."
                               Style="{StaticResource SubtleText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <controls:DataGrid x:Name="TargetsGrid" MinHeight="140" MaxHeight="380"
                                       AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Foreground="#1D1D1F">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="App" Binding="{Binding Name}" Width="150" />
                            <controls:DataGridTemplateColumn Header="Path" Width="230">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExePath}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding ExePath}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTemplateColumn Header="Discovered because" Width="*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Evidence}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Evidence}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTemplateColumn Header="Vendor" Width="170">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Vendor}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Vendor}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button x:Name="FreezeBtn" Content="❄ Freeze selected" Style="{StaticResource PrimaryButton}"
                                Click="FreezeBtn_Click" />
                        <Button x:Name="ThawBtn" Content="Unfreeze selected" Click="ThawBtn_Click"
                                ToolTipService.ToolTip="Restores the original permissions and re-allows updates." />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
