<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.HibernationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Hibernation &amp; Shutdown" Style="{StaticResource PageHeaderText}" Grid.Row="0" />

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- Hibernate Status -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Hibernation" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Hibernate writes RAM to disk — creates hiberfile that can be forensically analyzed."
                                   Style="{StaticResource SubtleText}" Margin="0,4,0,12" />

                        <Border Background="{ThemeResource RowAlternateBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock x:Name="HibernateStatusText" Text="Checking..." FontSize="12" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DisableHibernateBtn" Content="Disable Hibernate"
                                    Style="{StaticResource DangerButton}" Click="DisableHibernateBtn_Click" />
                            <Button x:Name="EnableHibernateBtn" Content="Enable Hibernate"
                                    Style="{StaticResource PrimaryButton}" Click="EnableHibernateBtn_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Power States -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Available Power States" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Border Background="{ThemeResource RowAlternateBrush}" CornerRadius="4" Padding="12,8">
                            <TextBlock x:Name="PowerStatesText" Text="Loading..." Style="{StaticResource SubtleText}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- True Shutdown -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="True Shutdown" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Performs a full shutdown (not hybrid). Clears RAM and all session state."
                                   Style="{StaticResource SubtleText}" Margin="0,4,0,12" />
                        <Button Content="⏻  True Shutdown Now" Style="{StaticResource DangerButton}"
                                Click="TrueShutdownBtn_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
