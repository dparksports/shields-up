<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource PageHeaderText}" Grid.Row="0" />

<Border Style="{StaticResource ContentPanel}" Grid.Row="1">
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">

                <!-- Application Information -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Application Information" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="Shields Up — Quick Scan, Attack Surface, Firewall, Bloatware, Telemetry, Privacy, Update Control, Tasks, Startup, Hibernation, OS Hardening, DBX Safety and Unblock in one administrator window."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Version:" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionValueText" Text="…" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Startup Behavior -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Startup Behavior" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="Launch Shields Up automatically when you log on (scheduled task with highest privileges — no extra UAC prompt)."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        <CheckBox x:Name="LaunchOnStartupCheck" Content="Launch at logon"
                                  Checked="LaunchOnStartupCheck_Checked" Unchecked="LaunchOnStartupCheck_Unchecked" />
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Updates" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="Checks the GitHub release for a newer version. Downloads land in your Downloads folder and are verified against the release's SHA256SUMS.txt before they count as valid — install by extracting and running the new exe."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesBtn" Content="Check for updates"
                                    Style="{StaticResource PrimaryButton}" Click="CheckUpdatesBtn_Click" />
                            <Button x:Name="DownloadUpdatesBtn" Content="Download &amp; verify" IsEnabled="False"
                                    Style="{StaticResource PrimaryButton}" Click="DownloadUpdatesBtn_Click" />
                            <Button x:Name="OpenReleasePageBtn" Content="Open release page"
                                    Click="OpenReleasePageBtn_Click" />
                        </StackPanel>
                        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Value="0"
                                     Visibility="Collapsed" Height="6" />
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Verify your copy -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Verify your copy" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="Checks the install you are running against the GitHub release: your version vs the latest, the downloaded zip's SHA256 vs the release checksum, and every release file present in this folder with the expected size."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        <Button x:Name="VerifyInstallBtn" Content="Verify this install"
                                Style="{StaticResource PrimaryButton}" Click="VerifyInstallBtn_Click" />
                        <TextBlock x:Name="VerifyStatusText" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Community: the live anonymous count + share -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Community" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="How many people run Shields Up — an anonymous, opt-in daily count (off by default, no identifier of any kind), charted live. Every install counts; pass the link on."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CommunityGraphBtn" Content="📈 Community graph"
                                    Style="{StaticResource PrimaryButton}" Click="CommunityGraphBtn_Click" />
                            <Button x:Name="ShareBtn" Content="🔗 Share Shields Up"
                                    Style="{StaticResource PrimaryButton}" Click="ShareBtn_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ShareStatusText" Style="{StaticResource SubtleText}" Text="" />
                    </StackPanel>
                </Border>

                <!-- Footnote -->
                <Border Style="{StaticResource CardPanel}" BorderThickness="0" Background="Transparent">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Made with ❤️ in California" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="© 2026 Dan Park · MagicPoint.ai" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Licensed under the Apache License 2.0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</Page>
