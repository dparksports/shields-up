<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShieldsUp.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Startup Persistence Scanner" Style="{StaticResource PageHeaderText}" />
                <TextBlock Text="Scans registry Run keys and Startup folders. Registry Run entries can be reversibly disabled (snapshotted) or restored."
                           Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Disable (Snapshot)" Click="DisableEntry_Click" />
                <Button Content="Restore" Click="RestoreEntry_Click" />
                <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- Startup Grid -->
<Border Style="{StaticResource ContentPanel}" Grid.Row="1">
        <controls:DataGrid Grid.Row="1" x:Name="StartupGrid" AutoGenerateColumns="False"
                           IsReadOnly="True" SelectionMode="Single" Foreground="#1D1D1F">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="State" Binding="{Binding State}" Width="150" />
                <controls:DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="130" />
                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190" />
                <controls:DataGridTextColumn Header="Target / Command" Binding="{Binding Value}" Width="*" />
            </controls:DataGrid.Columns>
            <controls:DataGrid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Disable (Snapshot)" Click="DisableEntry_Click" />
                    <MenuFlyoutItem Text="Restore Snapshot" Click="RestoreEntry_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Delete Permanently" Click="DeleteEntry_Click" />
                </MenuFlyout>
            </controls:DataGrid.ContextFlyout>
        </controls:DataGrid>
        </Border>
    </Grid>
</Page>
