<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShieldsUp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Shields Up">

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        RequestedTheme="Dark"
        SelectionChanged="Nav_SelectionChanged"
        OpenPaneLength="220">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Quick Scan" Tag="QuickScan">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x26A1;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Attack Surface" Tag="AttackSurface">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F4E1;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Firewall" Tag="Firewall">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F6E1;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Bloatware" Tag="Bloatware">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F4E6;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Telemetry" Tag="Telemetry">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F4CA;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Privacy" Tag="Privacy">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F441;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Update Control" Tag="UpdateControl">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x2744;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Tasks" Tag="Tasks">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F4CB;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Startup" Tag="Startup">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F680;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Hibernation" Tag="Hibernation">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F319;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="OS Hardening" Tag="Hardening">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x1F512;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="DBX Safety" Tag="DbxSafety">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x2705;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#x2699;" FontFamily="Segoe UI Emoji" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />

    </NavigationView>
</Window>
