<UserControl
    x:Class="ShieldsUp.Dialogs.BloatwareListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10" MinWidth="680" MaxWidth="760" MinHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource SubtleText}"
                   Text="Changes apply immediately and are saved to C:\ProgramData\ShieldsUp\bloatware_config.json (machine-wide). Defaults shipped in future app updates stay in force unless disabled here." />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Default list -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="10">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Default bloatware list" FontWeight="Bold" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="DefaultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Margin="0,3,0,3"
                                              Checked="DefaultCheck_Changed" Unchecked="DefaultCheck_Changed"
                                              ToolTipService.ToolTip="{Binding Pattern}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Custom entries -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="10">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Custom apps (exact package names)" FontWeight="Bold" />
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewPackageBox" Padding="4"
                                     FontFamily="Consolas" FontSize="11"
                                     KeyDown="NewPackageBox_KeyDown" />
                            <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}"
                                    Click="AddCustomPackageBtn_Click" />
                        </Grid>
                        <ListBox x:Name="CustomPackagesList" Grid.Row="2" MinHeight="60"
                                 FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="✕" FontSize="10" Padding="6,0"
                                                Style="{StaticResource DangerButton}" Click="RemoveCustomPackageBtn_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="10">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Custom patterns (advanced — substring match)" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource SubtleText}"
                                   Text="A pattern matches any package whose name or display name contains it. Prefer exact apps; use Preview below to check what a pattern would catch." />
                        <Grid Grid.Row="2" ColumnSpacing="6" Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewPatternBox" Padding="4"
                                     FontFamily="Consolas" FontSize="11"
                                     KeyDown="NewPatternBox_KeyDown" />
                            <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}"
                                    Click="AddCustomPatternBtn_Click" />
                        </Grid>
                        <ListBox x:Name="CustomPatternsList" Grid.Row="3" MinHeight="40"
                                 FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="✕" FontSize="10" Padding="6,0"
                                                Style="{StaticResource DangerButton}" Click="RemoveCustomPatternBtn_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Preview -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="PreviewBtn" Content="🔍 Preview matches" Style="{StaticResource PrimaryButton}"
                            Click="PreviewBtn_Click" />
                    <TextBlock x:Name="PreviewCountText" Text="See exactly what the current list would remove."
                               Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="PreviewList" Grid.Row="1" Height="110"
                         FontFamily="Consolas" FontSize="11" />
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="↺ Reset to defaults" Style="{StaticResource DangerButton}" Click="ResetBtn_Click" />
            <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="CloseBtn_Click" MinWidth="90" />
        </StackPanel>
    </Grid>
</UserControl>
