<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ControlCore.Pages.AttackSurfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Attack Surface" Style="{StaticResource PageHeaderText}" VerticalAlignment="Center" />
                <Button x:Name="RefreshBtn" Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Q1: SSTP / WAN Miniports -->
                <StackPanel Grid.Row="0" Grid.Column="0"
                            ToolTipService.ToolTip="WAN Miniport SSTP — remote access attack surface">
                    <TextBlock Text="System VPN Backdoors" Style="{StaticResource SectionHeaderText}" />
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SSTP Service (sstpsvc)" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SstpStatusText" Text="Loading..." Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <Button x:Name="SstpToggleBtn" Grid.Column="1" Content="Disable + Neuter"
                                        Style="{StaticResource PrimaryButton}" Click="SstpToggleBtn_Click" />
                            </Grid>

                            <TextBlock Text="WAN MINIPORTS" Style="{StaticResource SectionHeaderText}" />
                            <controls:DataGrid x:Name="WanMiniportGrid" MinHeight="110" MaxHeight="220"
                                               AutoGenerateColumns="False" IsReadOnly="True">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Q2: WiFi Direct -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            ToolTipService.ToolTip="WiFi Direct Hosted Network — hidden hotspot attack surface">
                    <TextBlock Text="Ghost Hotspots" Style="{StaticResource SectionHeaderText}" />
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hosted Network (WiFi)" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WifiDirectStatusText" Text="Loading..." Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <Button x:Name="WifiDirectToggleBtn" Grid.Column="1" Content="Toggle"
                                        Style="{StaticResource PrimaryButton}" Click="WifiDirectToggleBtn_Click" />
                            </Grid>

                            <Button x:Name="UninstallWifiBtn" Content="Uninstall Adapter" HorizontalAlignment="Left"
                                    Style="{StaticResource DangerButton}" Click="UninstallWifiBtn_Click" />

                            <TextBlock Text="WIFI DIRECT ADAPTERS" Style="{StaticResource SectionHeaderText}" />
                            <controls:DataGrid x:Name="WifiDirectGrid" MinHeight="110" MaxHeight="220"
                                               AutoGenerateColumns="False" IsReadOnly="True">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Q3: KDNET -->
                <StackPanel Grid.Row="1" Grid.Column="0"
                            ToolTipService.ToolTip="Kernel Debug Network Adapter (KDNET) — kernel-level access">
                    <TextBlock Text="Hacker Access Mode" Style="{StaticResource SectionHeaderText}" />
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="KDNET Adapter" FontWeight="SemiBold" />
                                    <TextBlock x:Name="KdnetStatusText" Text="Loading..." Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <Button x:Name="KdnetToggleBtn" Grid.Column="1" Content="Toggle"
                                        Style="{StaticResource PrimaryButton}" Click="KdnetToggleBtn_Click" />
                            </Grid>

                            <TextBlock Text="DEBUG ADAPTERS" Style="{StaticResource SectionHeaderText}" />
                            <controls:DataGrid x:Name="KdnetGrid" MinHeight="110" MaxHeight="220"
                                               AutoGenerateColumns="False" IsReadOnly="True">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <controls:DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Q4: WAN Miniport Removal -->
                <StackPanel Grid.Row="1" Grid.Column="1"
                            ToolTipService.ToolTip="Remove all WAN Miniport phantom devices">
                    <TextBlock Text="WAN Miniport Cleanup" Style="{StaticResource SectionHeaderText}" />
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                            <TextBlock Text="Remove all WAN Miniports."
                                       Style="{StaticResource SubtleText}" TextAlignment="Center" />
                            <Button x:Name="RemoveAllMiniportsBtn" Content="Remove All Miniports"
                                    Style="{StaticResource DangerButton}" Click="RemoveAllMiniportsBtn_Click"
                                    HorizontalAlignment="Center" />
                            <TextBlock x:Name="RemovalResultText" Text="" Style="{StaticResource SubtleText}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
