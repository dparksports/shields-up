<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ControlCore.Pages.HardeningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="OS Hardening" Style="{StaticResource PageHeaderText}" VerticalAlignment="Center" />
                <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- LSA Protection -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local Security Authority (LSA) Protection" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="RunAsPPL protects LSASS.exe from memory dumping tools like Mimikatz."
                                       Style="{StaticResource SubtleText}" />
                            <TextBlock x:Name="LsaStatusText" Text="Checking..." Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Disable" Style="{StaticResource DangerButton}" Click="LsaDisableBtn_Click" />
                            <Button Content="Enable" Style="{StaticResource PrimaryButton}" Click="LsaEnableBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- UAC Strictness -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="UAC Maximum Strictness" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Requires explicit consent for all administrative actions (ConsentPromptBehaviorAdmin=2)."
                                       Style="{StaticResource SubtleText}" />
                            <TextBlock x:Name="UacStatusText" Text="Checking..." Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Relax UAC" Style="{StaticResource DangerButton}" Click="UacRelaxBtn_Click" />
                            <Button Content="Max Strictness" Style="{StaticResource PrimaryButton}" Click="UacStrictBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hosts File Monitor -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hosts File Integrity" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="C:\Windows\System32\drivers\etc\hosts — often modified by malware for silent redirects."
                                           Style="{StaticResource SubtleText}" />
                                <TextBlock x:Name="HostsStatusText" Text="Checking..." Style="{StaticResource SubtleText}" Margin="0,8,0,12" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset to Default" VerticalAlignment="Top"
                                    Style="{StaticResource DangerButton}" Click="HostsResetBtn_Click" />
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="HostsContentBox" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="{ThemeResource RowAlternateBrush}" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11" MaxHeight="220" Padding="8"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- Disable IPv6 -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Disable IPv6 System-Wide" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Disables IPv6 on all network adapters to reduce attack surface (requires reboot)."
                                       Style="{StaticResource SubtleText}" />
                            <TextBlock x:Name="Ipv6StatusText" Text="Checking..." Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Enable IPv6" Style="{StaticResource DangerButton}" Click="Ipv6EnableBtn_Click" />
                            <Button Content="Disable IPv6" Style="{StaticResource PrimaryButton}" Click="Ipv6DisableBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
