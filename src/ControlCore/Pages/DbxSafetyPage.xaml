<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ControlCore.Pages.DbxSafetyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DBX / EFI Safety Check" Style="{StaticResource PageHeaderText}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunCheckBtn" Content="▶ Run Full Check"
                        Style="{StaticResource PrimaryButton}" Click="RunCheckBtn_Click" />
                <Button x:Name="RepairBootBtn" Content="Repair Boot"
                        Style="{StaticResource DangerButton}" Click="RepairBootBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- Results -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- EFI Partition -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="EFI PARTITION" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="EfiStatusText" Text="Not checked" Style="{StaticResource SubtleText}" />
                    </StackPanel>
                </Border>

                <!-- Baseline -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="INTEGRITY BASELINE" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="BaselineStatusText" Text="Not checked" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Sigcheck -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="AUTHENTICODE VERIFICATION" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="SigcheckStatusText" Text="Not checked" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- DBX Revocation -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DBX REVOCATION CHECK" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock x:Name="DbxStatusText" Text="Not checked" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- DBX Update -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DBX UPDATE" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock x:Name="DbxUpdateStatusText" Text="Download the latest DBX update from Microsoft"
                                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DownloadDbxBtn" Content="Download"
                                    Style="{StaticResource PrimaryButton}" Click="DownloadDbxBtn_Click" />
                            <Button x:Name="InstallDbxBtn" Content="Install" IsEnabled="False"
                                    Style="{StaticResource DangerButton}" Click="InstallDbxBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Output -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DETAILED LOG" Style="{StaticResource SectionHeaderText}" />
                        <TextBox x:Name="LogOutput" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="{ThemeResource RowAlternateBrush}" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11" MaxHeight="300" Padding="8"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
